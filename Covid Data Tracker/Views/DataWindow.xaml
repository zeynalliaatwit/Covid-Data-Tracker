<Window x:Class="Covid_Data_Tracker.DataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Covid_Data_Tracker"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="DataWindow" Height="720" Width="1280" WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl>
            <TabItem Header="Data Table">
                <StackPanel Margin="10">
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="105" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment ="Center"  Margin="10">
                        <Button Content="Find" Command="{Binding FindDateCommand}" Width="60" Height="20" Margin="0,0,10,0"/>
                        <Button Content="Clear" Command="{Binding ClearDateCommand}" Width="60" Height="20"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding DisplayedData}" AutoGenerateColumns="False" Margin="0,50,0,0" Height="235">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding ParsedDate}" Width="*" />
                            <DataGridTextColumn Header="North System" Binding="{Binding North}" Width="*" />
                            <DataGridTextColumn Header="South System" Binding="{Binding South}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>


            <TabItem Header="Rolling Averages">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <TextBlock Text="Start Date:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                        <DatePicker SelectedDate="{Binding ChartStartDate, Mode=TwoWay}" Width="110" Margin="0,0,15,0"/>

                        <TextBlock Text="End Date:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                        <DatePicker SelectedDate="{Binding ChartEndDate, Mode=TwoWay}" Width="110" Margin="0,0,15,0"/>

                        <Button Content="Filter" Command="{Binding FilterChartsCommand}" Width="90" Height="25" Margin="0,0,10,0"/>
                        <Button Content="Reset" Command="{Binding ResetChartsCommand}" Width="60" Height="25"/>
                    </StackPanel>

                    <TabControl>
                        <TabItem Header="North">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>

                                <lvc:CartesianChart Grid.Row="0" Series="{Binding NorthSeries}" Margin="0,0,0,10" DisableAnimations="True">

                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Date" Labels="{Binding DateLabels}" LabelsRotation="45"/>
                                    </lvc:CartesianChart.AxisX>

                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Cases"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>

                                <lvc:CartesianChart Grid.Row="1" Series="{Binding NorthTrendSeries}" DisableAnimations="True">

                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding DateLabels}" ShowLabels="False"/>
                                    </lvc:CartesianChart.AxisX>

                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Daily Change"/>
                                    </lvc:CartesianChart.AxisY>

                                </lvc:CartesianChart>
                            </Grid>
                        </TabItem>

                        <TabItem Header="South">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>

                                <lvc:CartesianChart Grid.Row="0" Series="{Binding SouthSeries}" Margin="0,0,0,10" DisableAnimations="True">

                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Date" Labels="{Binding DateLabels}" LabelsRotation="45"/>
                                    </lvc:CartesianChart.AxisX>

                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Cases"/>
                                    </lvc:CartesianChart.AxisY>

                                </lvc:CartesianChart>

                                <lvc:CartesianChart Grid.Row="1" Series="{Binding SouthTrendSeries}" DisableAnimations="True">

                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding DateLabels}" ShowLabels="False" />
                                    </lvc:CartesianChart.AxisX>

                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Daily Change"/>
                                    </lvc:CartesianChart.AxisY>

                                </lvc:CartesianChart>
                            </Grid>

                        </TabItem>

                        <TabItem Header="Total">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>

                                <lvc:CartesianChart Grid.Row="0" Series="{Binding TotalSeries}" Margin="0,0,0,10" DisableAnimations="True">

                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Date" Labels="{Binding DateLabels}" LabelsRotation="45" Sections="{Binding TotalChartSections}"/>
                                    </lvc:CartesianChart.AxisX>

                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Cases"/>
                                    </lvc:CartesianChart.AxisY>

                                </lvc:CartesianChart>

                                <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" 
                                        Background="#EEFFFFFF" BorderBrush="LightGray" BorderThickness="1" Padding="10" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="Historical Events" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" Foreground="#333333"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="Red" StrokeThickness="2" StrokeDashArray="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Mask Mandate (Apr 2020)" FontSize="11" Foreground="#555555"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="Green" StrokeThickness="2" StrokeDashArray="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Omicron Peak (Nov 2021)" FontSize="11" Foreground="#555555"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="Red" Stroke="DarkRed" Margin="6,0,14,0" />
                                            <TextBlock Text="Data Anomaly (2-Sigma)" FontSize="11" Foreground="#555555" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <lvc:CartesianChart Grid.Row="1" Series="{Binding TotalTrendSeries}" DisableAnimations="True">

                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding DateLabels}" ShowLabels="False" />
                                    </lvc:CartesianChart.AxisX>

                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Daily Change"/>
                                    </lvc:CartesianChart.AxisY>

                                </lvc:CartesianChart>

                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
